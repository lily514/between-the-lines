        "type": "object"
      },
      "StartIn": {
        "description": "Start watching, or carry on. Without a seed, the viewer's name chooses their matches.\n\nA ``club`` (team id) makes the viewer's matches that club's fixtures, if they haven't\nstarted watching.",
        "properties": {
          "club": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Club"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "viewer_id": {
            "title": "Viewer Id",
            "type": "string"
          }
        },
        "required": [
          "viewer_id"
        ],
        "title": "StartIn",
        "type": "object"
      },
      "StatusOut": {
        "description": "Where a viewer stands: which match is next, and their mastery of each concept.\n\n``club`` is the team they support. They can choose or change it while\n``can_choose_club``; ``suggested_club`` is the one \"Pick one for me\" starts from.",
        "properties": {
          "can_choose_club": {
            "title": "Can Choose Club",
            "type": "boolean"
          },
          "club": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClubOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "concepts": {
            "items": {
              "$ref": "#/components/schemas/Bar"
            },
            "title": "Concepts",
            "type": "array"
          },
          "finished": {
            "title": "Finished",
            "type": "boolean"
          },
          "fixture": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fixture"
              },
              {
                "type": "null"
              }
            ]
          },
          "match_number": {
            "title": "Match Number",
            "type": "integer"
          },
          "matches": {
            "title": "Matches",
            "type": "integer"
          },
          "suggested_club": {
            "title": "Suggested Club",
            "type": "integer"
          },
          "thresholds": {
            "$ref": "#/components/schemas/ThresholdsOut"
          },
          "viewer_id": {
            "title": "Viewer Id",
            "type": "string"
          }
        },
        "required": [
          "viewer_id",
          "match_number",
          "matches",
          "finished",
          "fixture",
          "club",
          "can_choose_club",
          "suggested_club",
          "concepts",
          "thresholds"
        ],
        "title": "StatusOut",
        "type": "object"
      },
      "TeamSheetOut": {
        "description": "Who's playing in the viewer's next match: their team first, or the home team.\n\n``next_stage`` says what opens more of the sheet; null at the last stage.",
        "properties": {
          "match_number": {
            "title": "Match Number",
            "type": "integer"
          },
          "next_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Stage"
          },
          "stage": {
            "title": "Stage",
            "type": "integer"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/SheetTeamOut"
            },
            "title": "Teams",
            "type": "array"
          }
        },
        "required": [
          "match_number",
          "stage",
          "next_stage",
          "teams"
        ],
        "title": "TeamSheetOut",
        "type": "object"
      },
      "ThresholdsOut": {
        "description": "When a concept unlocks the ones that need it, and when it counts as mastered.",
        "properties": {
          "mastery": {
            "title": "Mastery",
            "type": "number"
          },
          "unlock": {
            "title": "Unlock",
            "type": "number"
          }
        },
        "required": [
          "unlock",
          "mastery"
        ],
        "title": "ThresholdsOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Between the Lines",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/clubs": {
      "get": {
        "description": "The league's clubs, in team id order.",
        "operationId": "clubs_api_clubs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClubOut"
                  },
                  "title": "Response Clubs Api Clubs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Clubs"
      }
    },
    "/api/viewers": {
      "post": {
        "description": "Start watching, or carry on where the viewer stopped.",
        "operationId": "start_api_viewers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start"
      }
    },
    "/api/viewers/{viewer_id}": {
      "get": {
        "description": "Where a viewer stands.",
        "operationId": "get_status_api_viewers__viewer_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Status"
      }
    },
    "/api/viewers/{viewer_id}/answers": {
      "post": {
        "description": "Answer the waiting question and hear the feedback.",
        "operationId": "answer_api_viewers__viewer_id__answers_post",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Answer"
      }
    },
    "/api/viewers/{viewer_id}/club": {
      "put": {
        "description": "Choose the team to support, before answering anything.",
        "operationId": "put_club_api_viewers__viewer_id__club_put",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClubIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Club"
      }
    },
    "/api/viewers/{viewer_id}/next": {
      "post": {
        "description": "The question waiting to be answered, or full time if the match has no more.",
        "operationId": "next_step_api_viewers__viewer_id__next_post",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "full_time": "#/components/schemas/FullTimeOut",
                      "question": "#/components/schemas/QuestionOut"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/QuestionOut"
                    },
                    {
                      "$ref": "#/components/schemas/FullTimeOut"
                    }
                  ],
                  "title": "Response Next Step Api Viewers  Viewer Id  Next Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Next Step"
      }
    },
    "/api/viewers/{viewer_id}/team-sheet": {
      "get": {
        "description": "Who's playing in the viewer's next match, as much as their stage shows.",
        "operationId": "get_team_sheet_api_viewers__viewer_id__team_sheet_get",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamSheetOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Team Sheet"
      }
    }
  }
}
