                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target At"
          }
        },
        "required": [
          "key",
          "label",
          "correct",
          "chosen",
          "neutral",
          "outcome",
          "target_at"
