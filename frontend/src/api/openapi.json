{
  "components": {
    "schemas": {
      "AnswerIn": {
        "description": "An answer to the pending question, which ``pack_id`` names.",
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "pack_id": {
            "title": "Pack Id",
            "type": "string"
          }
        },
        "required": [
          "pack_id",
          "key"
        ],
        "title": "AnswerIn",
        "type": "object"
      },
      "Bar": {
        "description": "One concept's mastery, from 0 to 1.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "title": "Bar",
        "type": "object"
      },
      "DeliveredTime": {
        "description": "When a question is asked: live, or deferred to a stoppage or break (``restart`` names it).",
        "properties": {
          "clock": {
            "title": "Clock",
            "type": "string"
          },
          "delivery": {
            "enum": [
              "live",
              "deferred"
