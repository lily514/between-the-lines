  "info": {
    "title": "Between the Lines",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/viewers": {
      "post": {
        "description": "Start watching, or carry on where the viewer stopped.",
        "operationId": "start_api_viewers_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start"
      }
    },
    "/api/viewers/{viewer_id}": {
      "get": {
        "description": "Where a viewer stands.",
        "operationId": "get_status_api_viewers__viewer_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Status"
      }
    },
    "/api/viewers/{viewer_id}/answers": {
      "post": {
        "description": "Answer the waiting question and hear the feedback.",
        "operationId": "answer_api_viewers__viewer_id__answers_post",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Answer"
      }
    },
    "/api/viewers/{viewer_id}/next": {
      "post": {
        "description": "The question waiting to be answered, or full time if the match has no more.",
        "operationId": "next_step_api_viewers__viewer_id__next_post",
        "parameters": [
          {
            "in": "path",
            "name": "viewer_id",
            "required": true,
            "schema": {
              "title": "Viewer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "full_time": "#/components/schemas/FullTimeOut",
                      "question": "#/components/schemas/QuestionOut"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/QuestionOut"
                    },
                    {
                      "$ref": "#/components/schemas/FullTimeOut"
                    }
                  ],
                  "title": "Response Next Step Api Viewers  Viewer Id  Next Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Next Step"
      }
    }
  }
}
