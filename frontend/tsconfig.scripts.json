{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["scripts/*.ts"]
}
