            "type": "string"
          },
          "period": {
            "title": "Period",
            "type": "integer"
          },
          "phase": {
            "title": "Phase",
            "type": "string"
          },
          "restart": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restart"
          },
          "seconds": {
            "title": "Seconds",
            "type": "number"
          }
        },
        "required": [
          "period",
          "seconds",
          "clock",
          "phase",
          "delivery",
          "restart"
        ],
        "title": "DeliveredTime",
        "type": "object"
      },
      "FactOut": {
        "description": "A fact: its value, and the text to show for it (number only, as the engine formats it).",
