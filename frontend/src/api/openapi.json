      "StartIn": {
        "description": "Start watching, or carry on. Without a seed, the viewer's name chooses their matches.",
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
