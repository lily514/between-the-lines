{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL}"
    },
    "minReplicas": {
      "value": "${MIN_REPLICAS=0}"
    },
    "webExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    },
    "tutor": {
      "value": "${TUTOR=template}"
    },
    "foundryEndpoint": {
      "value": "${FOUNDRY_ENDPOINT=}"
    },
    "foundryDeployment": {
      "value": "${FOUNDRY_DEPLOYMENT=}"
    }
  }
}
